{
  "name": "pdf-reformatter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first PDF reflow reader for GitHub Pages",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/run.mjs setup",
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/run.mjs build",
    "preview": "node scripts/run.mjs preview",
    "typecheck": "node scripts/run.mjs typecheck",
    "lint": "node scripts/run.mjs lint",
    "test": "node scripts/run.mjs test",
    "test:unit": "node scripts/run.mjs test-unit",
    "test:e2e": "node scripts/run.mjs test-e2e",
    "format": "node scripts/run.mjs format",
    "format:check": "node scripts/run.mjs format-check",
    "check": "node scripts/run.mjs check",
    "clean-repo": "node scripts/run.mjs clean-repo"
  },
  "prettier": "./config/prettier.json",
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "lucide-react": "1.63.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
